<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fullScreenBackgroundColor">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.myAllVideoBrowser.ui.main.localplayer.LocalMpvView
            android:id="@+id/video_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- paddingTop 的基础值由代码 applyWindowInsets() 动态补上状态栏高度,
         这里只留基础 8dp, 不要写死 36dp, 否则会和状态栏高度叠加导致顶栏过高。 -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#66000000"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <!-- 右侧两个按钮放进一个横向 LinearLayout, 用 alignParentEnd 整体靠右。
             不要用链式 layout_toStartOf(原写法: text->subtitle->rotate) 互相约束,
             那条依赖链在 RelativeLayout 里会让 subtitle_button 缺少明确定位基准,
             表现为按钮被推到屏幕外 / 不渲染。这里改成"一组靠右"的结构, 稳定。 -->
        <LinearLayout
            android:id="@+id/top_bar_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/subtitle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/icon_subtitles"
                app:tint="@color/neutralIconTint"/>

            <ImageButton
                android:id="@+id/rotate_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/icon_screen_rotation"
                app:tint="@color/neutralIconTint"/>

        </LinearLayout>

        <TextView
            android:id="@+id/text_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/top_bar_actions"
            android:layout_centerVertical="true"/>

    </RelativeLayout>

    <!-- 和 DroidFS 播放器一样: 一排五个按钮(上一个/快退10/大播放/快进10/下一个) + 进度条。
         paddingBottom 的基础值由代码 applyWindowInsets() 动态补上导航栏高度,
         这里只留基础 12dp, 不要写死更多, 否则会和导航栏高度叠加。 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/prev_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/icon_arrow_back"
                app:tint="@color/white"/>

            <ImageButton
                android:id="@+id/rewind_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/icon_replay_10"
                app:tint="@color/white"/>

            <ImageButton
                android:id="@+id/play_pause_button"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/circle_button_background"
                android:padding="14dp"
                android:src="@drawable/icon_pause"
                app:tint="@color/white"/>

            <ImageButton
                android:id="@+id/forward_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/icon_forward_10"
                app:tint="@color/white"/>

            <ImageButton
                android:id="@+id/next_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/icon_arrow_forward"
                app:tint="@color/white"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/text_position"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:text="00:00"/>

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:max="1000" />

            <TextView
                android:id="@+id/text_duration"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:gravity="end"
                android:text="00:00"/>

        </LinearLayout>

    </LinearLayout>

    <!-- 滑动快进时显示的当前位置和变化量, 和 DroidFS 播放器一样 -->
    <TextView
        android:id="@+id/gesture_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="4"
        android:textAlignment="center"
        android:textColor="#ffffff"
        android:textSize="36sp"
        android:textStyle="bold"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</RelativeLayout>
